# Supabase → Project Settings → API  (обязательно)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Необязательно. Без этих ключей доска работает, транскрипт вставляется вручную. ---

# Расшифровка записей: любой сервис с OpenAI-совместимым /audio/transcriptions
TRANSCRIBE_API_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=gpt-transcribe

# Брифы созвонов: либо Anthropic напрямую...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ...либо любой сервис с OpenAI-совместимым /chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
